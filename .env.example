# ==============================================================================
# PickyHack — Configuration Template (.env.example)
# Copy this file to .env and configure your environment variables.
# NEVER commit your actual .env file with real secrets to Git.
# ==============================================================================

# Application Server Port
PORT=8088

# AI / LLM Engine Settings (Optional for offline/standalone mode)
# PROVIDER options: local | gemini | openai | anthropic
AI_PROVIDER=local

# API Keys (Optional - only required if using external cloud LLM providers)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Threat Intelligence APIs (Optional)
# CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# NVD_API_KEY=your_nvd_api_key_here

# Security Notice
# Only assess targets you are explicitly authorized to test in writing.
