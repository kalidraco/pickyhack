# ==============================================================================
# PickyHack — Configuration Template (.env.example)
# Copy this file to .env and configure your environment variables.
# NEVER commit your actual .env file with real secrets to Git.
#
# PickyHack is a Stateless AI Context Harness:
# All API keys can also be configured securely inside the UI via the
# [ Multi-API ] Manager and are stored locally in your browser (localStorage).
# ==============================================================================

# Application Server Port
PORT=8088

# Primary AI / LLM Provider (Optional fallback for server configurations)
# Options: openai | anthropic | gemini | mistral | openrouter | custom
AI_PROVIDER=openai

# External Cloud LLM API Keys (Optional - configure directly in PickyHack UI)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local LLM Endpoint (e.g. Ollama, LMStudio, vLLM)
# LOCAL_LLM_ENDPOINT=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.3:70b

# Threat Intelligence APIs (Optional)
# CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# NVD_API_KEY=your_nvd_api_key_here

# Security Notice
# Only assess targets you are explicitly authorized to test in writing.
